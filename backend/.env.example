# DepControl backend configuration. Copy to `.env` and fill in the secrets.
# The backend reads these from the process environment (see lib/src/deps.dart).
# `.env` is gitignored; never commit real credentials.

# --- Auth (Supabase JWT verification) -------------------------------------
# Modern path: signing keys verified against the project JWKS. Setting
# SUPABASE_URL is enough — the JWKS URL is derived automatically.
SUPABASE_URL=https://ogsnkqlamfvftdgvvtje.supabase.co

# Legacy alternative (only if you use the shared HS256 secret instead):
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# --- Persistence (Phase 3: Supabase Postgres) -----------------------------
# When set, the API persists projects/reports to Postgres; when unset it falls
# back to the in-memory repository (state lost on restart).
#
# The API-diff CLIs (tool/fill_api_diffs.dart, tool/import_api_diff.dart) need
# this too, and always use Postgres — a diff written to the dev server's
# in-memory store would live in that process and never be read.
#
# Grab the exact string + password from the Supabase dashboard:
#   Project Settings -> Database -> Connection string
# Use the "Session pooler" option for IPv4 + prepared-statement support
# (the backend uses the extended query protocol, which transaction-mode
# pooling on port 6543 does not fully support).
#
# Session pooler (recommended):
DATABASE_URL=postgresql://postgres.ogsnkqlamfvftdgvvtje:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct connection (requires IPv6, or the IPv4 add-on):
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.ogsnkqlamfvftdgvvtje.supabase.co:5432/postgres?sslmode=require

# --- Rate limiting --------------------------------------------------------
# Per-user limit on the endpoints that fetch a repository and query pub.dev
# (add, refresh, resolve, upgrade). Reading stored projects and reports is not
# counted. One request to add a project becomes one outbound request per
# dependency, so this protects both the server and its standing with pub.dev.
#
# Sustained rate per user per minute. 0 disables limiting entirely.
# RATE_LIMIT_PER_MINUTE=20
#
# Largest burst a user may spend at once. Defaults to RATE_LIMIT_PER_MINUTE,
# which allows adding a few projects in a row without waiting.
# RATE_LIMIT_BURST=20
#
# Note the counters are per process: behind several instances the effective
# limit is this multiplied by the instance count.

# --- Notifications -------------------------------------------------------
# Where the UI lives, so a notification can link to the report it is about.
# Not a secret (it is the public address of the front end). Leave it unset and
# notifications carry no link rather than a guessed one.
# APP_BASE_URL=https://depcontrol.pages.dev
#
# There is nothing else to configure here. Slack and Teams incoming webhooks
# carry their own credential in the URL, which is stored per target through
# POST /notifications — see backend/sql/notifications.sql. The server will only
# deliver to the hosts those two providers actually serve webhooks on; see
# lib/src/notifications/webhook_url.dart.
#
# The announcements are sent by `dart run tool/rescan.dart`, not by the API, so
# the deployed server never posts to a webhook in a request. That CLI needs
# DATABASE_URL above; see .github/workflows/rescan.yml for the schedule.

# --- Logging --------------------------------------------------------------
# ENV drives logging: anything other than "production" is treated as
# development (coloured output + per-request logging). Defaults to development.
ENV=development
# Minimum level to emit: debug|info|warn|error.
# Defaults to debug in development, info in production.
# LOG_LEVEL=debug
# Set NO_COLOR=1 to disable ANSI colours even in development.
# NO_COLOR=1
